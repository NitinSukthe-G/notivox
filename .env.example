# Copy this file to ".env" and fill in your own values.
# .env is secret (never shared); this .env.example is a safe template anyone can see.

# Your Sarvam AI key (from https://dashboard.sarvam.ai)
SARVAM_API_KEY=your-sarvam-key-here

# Your MongoDB connection URL (from MongoDB Atlas -> Connect -> Drivers)
MONGODB_URI=your-mongodb-connection-string-here

# Name of the database NOTIVOX will create inside MongoDB
MONGODB_DB=notivox

